# ─────────────────────────────────────────────────────────────────────────────
# LAND STACK — Backend Environment Configuration
# SIH26014 | Integrated GIS-based Digital Public Infrastructure
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Land Stack API"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://landstack:landstack_dev_2026@localhost:5432/landstack_db
# When running via Docker Compose, this is overridden to use host=db

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_KEY_BEFORE_PRODUCTION
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Demo Admin Seed ───────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@landstack.demo
ADMIN_PASSWORD=LandStack@2026
ADMIN_NAME=System Administrator
